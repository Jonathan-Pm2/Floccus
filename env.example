# Plantilla de configuración para el proyecto.
#
# Copialo como .env en este directorio o en el directorio padre del workspace
# (el código busca .env primero en biofloc-review/ y después un nivel arriba):
#
#   cp env.example .env
#   nano .env   # rellenar los valores reales
#
# Nunca versionar el .env real (.gitignore ya lo excluye).

# ---- Ollama (servidor remoto con GPU) -------------------------------------
OLLAMA_URL=https://ollama-internal.example.com
OLLAMA_TOKEN=<bearer-token-aqui>

# Modelos por defecto (opcional; el código usa estos si no se setea)
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
OLLAMA_LLM_MODEL=qwen3:14b

# ---- OpenAlex --------------------------------------------------------------
OPENALEX_EMAIL=tu-correo@dominio.com
# rate limit sostenido. 0.5 ultra-conservador, 1.0 balance recomendado,
# >=2.0 dispara bloqueo HTTP 429 prolongado.
OPENALEX_RPS=1.0

# ---- Qdrant (opcional; default localhost) ---------------------------------
# QDRANT_URL=http://localhost:6333
