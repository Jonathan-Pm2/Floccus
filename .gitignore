# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.python-version-local

# Secrets
.env
.env.local

# Data — gitignored by default; data/published/ is the exception
# (carries sanitized release artifacts).
data/
!data/published/
qdrant_storage/

# Logs (long, time-stamped, not part of the pipeline definition)
*.log

# IDE / OS / generic tooling
.idea/
.vscode/
.DS_Store
*.tmp
*.bak
*.swp

# Claude Code / agent tooling (not part of reproducible pipeline)
.mcp.json
.claude/
docs/.atl/

# Build artifacts from LaTeX compilation
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.bbl
docs/*.blg
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

# Elsevier elsarticle LaTeX template — used only to compile the manuscript
# locally. Since the manuscript itself is untracked until journal acceptance,
# the template is also untracked. Users compiling the paper post-acceptance
# can fetch elsarticle from CTAN (https://ctan.org/pkg/elsarticle).
docs/elsarticle/

# Paper artifacts — NOT tracked until journal acceptance.
# Pipeline code stays public; manuscript narrative + figures remain private
# until the systematic review is formally accepted for publication. After
# acceptance, these entries are removed from .gitignore and re-added in a
# clean release commit.
docs/revision_sistematica_biofloc_es.tex
docs/revision_sistematica_biofloc_es.pdf
docs/figures/

# Institutional session cookies (Shibboleth/OpenAthens). Never commit:
# they grant access to paywalled content via the user's USAL credentials.
cookies.txt
cookies_*.txt
*.cookies.txt
*cookies*.txt
data/fulltext/
