# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.python-version-local

# Secrets
.env
.env.local

# Data — gitignored by default; data/published/ is the exception
# (carries sanitized release artifacts).
data/
!data/published/
qdrant_storage/

# Logs (long, time-stamped, not part of the pipeline definition)
*.log

# IDE / OS / generic tooling
.idea/
.vscode/
.DS_Store
*.tmp
*.bak
*.swp

# Claude Code / agent tooling (not part of reproducible pipeline)
.mcp.json
.claude/
docs/.atl/

# Build artifacts from LaTeX compilation
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.bbl
docs/*.blg
docs/*.fls
docs/*.fdb_latexmk
docs/*.synctex.gz

# Elsevier elsarticle LaTeX template — used only to compile the manuscript
# locally. Since the manuscript itself is untracked until journal acceptance,
# the template is also untracked. Users compiling the paper post-acceptance
# can fetch elsarticle from CTAN (https://ctan.org/pkg/elsarticle).
docs/elsarticle/

# Paper artifacts — NOT tracked until journal acceptance.
# Pipeline code stays public; manuscript narrative + figures remain private
# until the systematic review is formally accepted for publication. After
# acceptance, these entries are removed from .gitignore and re-added in a
# clean release commit.
docs/revision_sistematica_biofloc_es.tex
docs/revision_sistematica_biofloc_es.pdf
docs/revision_sistematica_biofloc_en.tex
docs/revision_sistematica_biofloc_en.pdf
docs/figures/
docs/figures_en/
docs/cover_letter_applied_ai.tex
docs/cover_letter_applied_ai.pdf
docs/cover_letter_statistica_neerlandica.tex
docs/cover_letter_statistica_neerlandica.pdf
docs/cover_letter_aquacultural_engineering.tex
docs/cover_letter_aquacultural_engineering.pdf
docs/cover_letter_environmental_modelling_software.tex
docs/cover_letter_environmental_modelling_software.pdf
docs/highlights_environmental_modelling_software.tex
docs/highlights_environmental_modelling_software.pdf
docs/cover_letter_ecological_informatics.tex
docs/cover_letter_ecological_informatics.pdf
docs/highlights_ecological_informatics.tex
docs/highlights_ecological_informatics.pdf
docs/supplementary_material.tex
docs/supplementary_material.pdf
docs/revision_sistematica_biofloc_reduced.tex
docs/revision_sistematica_biofloc_reduced.pdf
docs/figures_en/fig_sankey_pipeline.pdf
docs/figures_en/fig_sankey_pipeline.png
docs/highlights_applied_ai.tex
docs/highlights_applied_ai.pdf
docs/OSF_PREREGISTRATION.md

# Institutional session cookies (Shibboleth/OpenAthens). Never commit:
# they grant access to paywalled content via the user's USAL credentials.
cookies.txt
cookies_*.txt
*.cookies.txt
*cookies*.txt
data/fulltext/

# Playwright browser profile — contains live USAL session cookies and
# auth tokens. Never commit.
data/playwright_profile/
.playwright/

# Third-party paper PDFs downloaded at repo root (Khraisha, Elsevier, etc.).
# Copyright of their publishers — never redistribute in a public archive.
/*.pdf

# docs/ holds the manuscript narrative, cover letters, and author-identity
# artifacts, which stay OUT of the public code archive until journal
# acceptance. The per-filename entries above kept drifting as files were
# renamed, so this rule ignores ALL of docs/ except the data documentation
# that is genuinely part of the public pipeline. Drift-proof by construction.
docs/*
!docs/DATA.md
